<?xml version="1.0" encoding="UTF-8"?>
<!--
  Instalador do telinha (WiX 3). Gerado por installer\build-msi.ps1, que passa:
    Version  - versão do Cargo.toml (ex.: 0.1.0)
    BinDir   - pasta com telinha.exe, telinha-cli.exe e cloudflared.exe
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="telinha"
           Language="1046"
           Codepage="1252"
           Version="$(var.Version)"
           Manufacturer="joaopedrolacerda"
           UpgradeCode="8306AC28-CE78-4483-8C39-9878872ADEBE">

    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="telinha - compartilhamento de tela por link temporário"
             Comments="https://github.com/joaopedrolacerda/Telinha" />

    <!-- Instalar uma versão nova substitui a antiga. -->
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do telinha já está instalada." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="telinha.exe" SourceFile="$(var.BinDir)\telinha.exe" />
    <Property Id="ARPPRODUCTICON" Value="telinha.exe" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/joaopedrolacerda/Telinha" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="telinha" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLFOLDER">
      <Component Id="App" Guid="*" Win64="yes">
        <File Id="telinha.exe" Source="$(var.BinDir)\telinha.exe" KeyPath="yes" />
      </Component>
      <Component Id="Cli" Guid="*" Win64="yes">
        <File Id="telinha_cli.exe" Source="$(var.BinDir)\telinha-cli.exe" KeyPath="yes" />
      </Component>
      <!-- O telinha procura o cloudflared primeiro na própria pasta. -->
      <Component Id="Cloudflared" Guid="*" Win64="yes">
        <File Id="cloudflared.exe" Source="$(var.BinDir)\cloudflared.exe" KeyPath="yes" />
      </Component>
      <Component Id="Readme" Guid="*" Win64="yes">
        <File Id="README.md" Source="$(var.BinDir)\README.md" KeyPath="yes" />
      </Component>
      <Component Id="CloudflaredLicense" Guid="*" Win64="yes">
        <File Id="cloudflared_LICENSE.txt" Source="$(var.BinDir)\cloudflared-LICENSE.txt" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="E512E0E9-AE83-4F2D-B04C-872B02B80C02" Win64="yes">
        <Shortcut Id="StartMenuShortcut" Name="telinha"
                  Description="Compartilhar a tela por um link temporário"
                  Target="[INSTALLFOLDER]telinha.exe" WorkingDirectory="INSTALLFOLDER" Icon="telinha.exe" />
        <RegistryValue Root="HKCU" Key="Software\telinha" Name="startmenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="69B018A2-EB6A-431D-A6D7-C7108C4F408A" Win64="yes">
        <Shortcut Id="DesktopShortcut" Name="telinha"
                  Description="Compartilhar a tela por um link temporário"
                  Target="[INSTALLFOLDER]telinha.exe" WorkingDirectory="INSTALLFOLDER" Icon="telinha.exe" />
        <RegistryValue Root="HKCU" Key="Software\telinha" Name="desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="telinha" Level="1">
      <ComponentRef Id="App" />
      <ComponentRef Id="Cli" />
      <ComponentRef Id="Cloudflared" />
      <ComponentRef Id="Readme" />
      <ComponentRef Id="CloudflaredLicense" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
